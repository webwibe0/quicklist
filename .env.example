# LOCAL DEVELOPMENT ONLY. Copy to .env, choose your own password, never publish .env.
APP_ENVIRONMENT=local
APP_TIMEZONE=Europe/Moscow
POSTGRES_USER=assistant
POSTGRES_PASSWORD=replace_with_your_own_local_password
POSTGRES_DB=quicklist_dev
POSTGRES_PORT=15432
DATABASE_URL=postgresql+psycopg://assistant:replace_with_your_own_local_password@127.0.0.1:15432/quicklist_dev
DB_CONNECT_TIMEOUT_SECONDS=3
BACKEND_URL=http://127.0.0.1:8000
AUTH_ORIGIN=http://127.0.0.1:3000
AUTH_COOKIE_SECURE=false
# Local accounts only. Public hosting requires HTTPS/Secure/verification and working SMTP.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_REGISTRATION_ENABLED=true
AUTH_SESSION_DAYS=7
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_ACCOUNT_LIMIT=5
# Auth uses opaque DB-backed session cookies, not JWT. No JWT secret is needed.
# Own OpenAI key and explicit spending policy are required for real AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LLM_TIMEOUT_SECONDS=30
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
VOICE_TIMEOUT_SECONDS=45
RESULT_LIMIT=50
# Fail closed by default. accounting_only permits paid usage without internal lifetime stops.
AI_USAGE_MODE=capped
AI_TOTAL_BUDGET_USD=0
INTERACTIVE_BUDGET_USD=0
INTERACTIVE_BUDGET_MAX_CALLS=0
# Paths default to ignored .local/; preserve existing ledger when restarting.
# INTERACTIVE_BUDGET_PATH=/your/private/persistent/interactive-budget.sqlite3
# Query embeddings and background indexing are optional and off in fresh copies.
SEMANTIC_SEARCH_ENABLED=false
SEMANTIC_MIN_SIMILARITY=0.7
SEMANTIC_CANDIDATE_LIMIT=100
EMBEDDING_REAL_API_ENABLED=false
EMBEDDING_WORKER_ENABLED=false
EMBEDDING_WORKER_IN_WEB=true
EMBEDDING_PRODUCTION_INDEXING_APPROVED=false
EMBEDDING_ALLOWED_CLUSTER_ID=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_DOCUMENTS=128
EMBEDDING_MAX_INPUT_BYTES=8000
EMBEDDING_MAX_RUN_BYTES=64000
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_LEASE_SECONDS=60
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BASE_SECONDS=2
EMBEDDING_RETRY_MAX_SECONDS=300
EMBEDDING_POLL_SECONDS=10
EMBEDDING_BUDGET_USD=0
EMBEDDING_BUDGET_MAX_CALLS=500
EMBEDDING_MIN_CALL_INTERVAL_SECONDS=30
# EMBEDDING_BUDGET_PATH=/your/private/persistent/embedding-budget.sqlite3
# Optional SMTP: 587 uses STARTTLS; MAIL_SSL=true selects implicit TLS, e.g. Resend 465.
MAIL_HOST=
MAIL_PORT=587
MAIL_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
SUPPORT_EMAIL=
# Optional Google Web OAuth client. Create your own client/key, never reuse production secrets.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/calendar/google/callback
