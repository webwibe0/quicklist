AUTH_ORIGIN=https://quicklist.example.test
SUPPORT_EMAIL=support@quicklist.example.test
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_FROM=no-reply@quicklist.example.test
