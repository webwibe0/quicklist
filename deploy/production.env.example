GOOGLE_CLIENT_ID=
SECRETS_DIR=/etc/quicklist/secrets
CADDY_CONFIG=./Caddyfile.public
STAGING_USER=REPLACE_WITH_PRIVATE_PRELAUNCH_USERNAME
STAGING_PASSWORD_HASH=REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT
PYTHON_IMAGE=python@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f
NODE_IMAGE=node@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c
